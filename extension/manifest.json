{
  "manifest_version": 2,
  "name": "Thunderbird Rich Text",
  "version": "1.0.0",
  "description": "Thoughtful formatting for your emails: fonts, colors, highlights, lists, links, and emoji in Thunderbird's own editor.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rich-text@thunderbird-rich-text.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["compose", "storage"],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "compose_action": {
    "default_title": "Rich Text — format your message",
    "default_label": "Rich Text",
    "default_area": "maintoolbar",
    "default_icon": "icons/rich-text.svg",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "32": "icons/rich-text.svg",
    "64": "icons/rich-text.svg"
  },
  "commands": {
    "_execute_compose_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open Rich Text in the compose window"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'"
}
