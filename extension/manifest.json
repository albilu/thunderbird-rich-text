{
  "manifest_version": 2,
  "name": "Thunderbird Rich Text",
  "version": "1.2.0",
  "description": "Thoughtful formatting for your emails: fonts, colors, highlights, lists, links, and emoji in Thunderbird's own editor.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rich-text@thunderbird-rich-text.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["compose", "storage"],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "composeToolbar": {
      "schema": "experiments/compose-toolbar/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["composeToolbar"]],
        "script": "experiments/compose-toolbar/api.js"
      }
    }
  },
  "icons": {
    "32": "icons/rich-text.svg",
    "64": "icons/rich-text.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'"
}
